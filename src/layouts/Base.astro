---
export interface Props {
  title: string;
  description?: string;
  /** Canonical path override; defaults to the current page path. */
  path?: string;
  /** OG/Twitter share image (absolute path from site root). */
  image?: string;
  /** OG type, "website" for the homepage, "article" or "service" pages. */
  type?: string;
  /** Page-specific JSON-LD structured data (object or array of objects). */
  jsonld?: Record<string, any> | Record<string, any>[];
  /** Set true to keep a page out of search results. */
  noindex?: boolean;
}
const {
  title,
  description = "Thomas McKee is a design engineering and product development consultant in Edinburgh, helping founders and startups take consumer hardware from concept to production.",
  path,
  image = "/og.png",
  type = "website",
  jsonld,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.tmdesignengineering.com");
const canonical = new URL(path ?? Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// Site-wide structured data, present on every page for local + brand SEO.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": new URL("/#business", site).href,
  name: "Thomas McKee Design Engineering",
  description:
    "Independent design engineering and product development consultancy helping founders and startups take consumer hardware from concept to production.",
  url: site.href,
  email: "thomas.h.s.mckee@outlook.com",
  areaServed: ["United Kingdom", "Worldwide"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Edinburgh",
    addressRegion: "Scotland",
    addressCountry: "GB",
  },
  priceRange: "££",
  knowsAbout: [
    "Design engineering",
    "Product development",
    "Consumer hardware",
    "Design for manufacture (DFM)",
    "Feasibility studies",
    "MVP development",
    "Prototyping",
    "Mechanical design",
    "Firmware",
    "Thermal analysis",
  ],
  founder: {
    "@type": "Person",
    "@id": new URL("/#thomas-mckee", site).href,
    name: "Thomas McKee",
    jobTitle: "Design Engineering Consultant",
    description:
      "Design engineer with 4+ years developing award-winning consumer products at Ooni, spanning mechanical design, firmware and manufacture.",
    alumniOf: { "@type": "Organization", name: "Ooni" },
    // Real, verifiable design awards. Helps search engines and AI assistants
    // recognise the work as credible when deciding whom to recommend.
    award: [
      "Red Dot Design Award 2026 (Ooni Volt 2)",
      "iF Design Award 2024 (Ooni Karu 2)",
      "German Design Award 2024 (Ooni Karu 2)",
      "iF Design Award 2025 (Ooni Karu 2 Pro)",
    ],
    // TODO (Tom): paste your real public profile URLs here to strengthen entity
    // recognition. This is one of the strongest signals for being surfaced as a
    // real, credible person. Uncomment and fill in, e.g.:
    // sameAs: [
    //   "https://www.linkedin.com/in/YOUR-HANDLE",
    //   "https://ooni.com/...",                     // an Ooni team/press page that names you
    //   "https://www.red-dot.org/...",              // the Red Dot award citation page
    //   "https://ifdesign.com/...",                 // the iF award listing
    // ],
    knowsAbout: [
      "Design engineering",
      "Consumer product development",
      "Design for manufacture",
      "Thermal systems",
      "Firmware",
      "Hardware startup product development",
      "Injection moulding",
      "Prototyping",
    ],
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": new URL("/#website", site).href,
  url: site.href,
  name: "Thomas McKee Design Engineering",
  publisher: { "@id": new URL("/#business", site).href },
  inLanguage: "en-GB",
};

const pageSchemas = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const schemas = [businessSchema, websiteSchema, ...pageSchemas];

import "../styles/global.css";
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large" />}
<meta name="author" content="Thomas McKee" />
<meta name="theme-color" content="#1A1B1D" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Thomas McKee Design Engineering" />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
{schemas.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}
</head>
<body>
<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <span class="name">Thomas McKee</span>
      <span class="disc">Design Engineering</span>
    </a>
    <nav class="nav-links">
      <a href="/#services">Services</a>
      <a href="/about">About</a>
      <a href="/#work">Portfolio</a>
      <a href="/#contact">Contact</a>
    </nav>
    <button class="icon-btn" id="theme" aria-label="Toggle colour theme" title="Toggle theme">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="sun" d="M12 3v1.5M12 19.5V21M4.2 4.2l1.1 1.1M18.7 18.7l1.1 1.1M3 12h1.5M19.5 12H21M4.2 19.8l1.1-1.1M18.7 5.3l1.1-1.1"/><circle cx="12" cy="12" r="4"/></svg>
    </button>
    <a class="btn btn-primary" href="/#contact">Book a call <span class="arw">→</span></a>
  </div>
</header>
<slot />
<footer>
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand">
          <div class="name">Thomas McKee Design Engineering</div>
          <div class="disc">Consumer Product Development · Edinburgh, UK</div>
        </div>
        <nav class="foot-links">
          <a href="/#services">Services</a>
          <a href="/about">About</a>
          <a href="/#work">Portfolio</a>
          <a href="/#contact">Contact</a>
          <a href="/services/power-hour">Power Hour</a>
          <a href="/services/design-review">Design Review</a>
          <a href="/services/feasibility-study">Feasibility Study</a>
          <a href="/services/concept-mvp-development">Concept &amp; MVP</a>
          <a href="/services/design-verification">Design Verification</a>
          <a href="/services/manufacturing-preparation">Manufacturing Preparation</a>
          <a href="/services/product-development">Product Development</a>
          <a href="/services/contract-engineering">Contract Engineering</a>
        </nav>
      </div>
      <div class="foot-meta">
        <span>© 2026 Thomas McKee Design Engineering</span>
        <span>thomas.h.s.mckee@outlook.com</span>
      </div>
    </div>
  </footer>
<script>
  (function(){
    var root=document.documentElement, btn=document.getElementById('theme');
    var saved=null;
    try{saved=localStorage.getItem('tmde-theme');}catch(e){}
    if(saved){root.setAttribute('data-theme',saved);}
    btn.addEventListener('click',function(){
      var cur=root.getAttribute('data-theme');
      var isDark = cur ? cur==='dark' : window.matchMedia('(prefers-color-scheme:dark)').matches;
      var next=isDark?'light':'dark';
      root.setAttribute('data-theme',next);
      try{localStorage.setItem('tmde-theme',next);}catch(e){}
    });
  })();
</script>
</body>
</html>
