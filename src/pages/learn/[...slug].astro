---
import Base from "../../layouts/Base.astro";
import "../../styles/service.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const SITE = "https://www.tmdesignengineering.com";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"guides"> };
const { entry } = Astro.props;
const { Content } = await entry.render();
const url = `${SITE}/learn/${entry.slug}`;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${url}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
    author: { "@id": `${SITE}/#thomas-mckee` },
    publisher: { "@id": `${SITE}/#business` },
    isPartOf: { "@id": `${SITE}/#website` },
    mainEntityOfPage: url,
    url,
    keywords: entry.data.tags.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${SITE}/learn` },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: url },
    ],
  },
];
---
<Base
  title={`${entry.data.title} | Thomas McKee`}
  description={entry.data.description}
  type="article"
  jsonld={jsonld}>
<main>
  <article class="svc-hero" style="padding-bottom:0">
    <div class="wrap" style="max-width:760px">
      <a class="back" href="/learn">← Learning Hub</a>
      <div class="art-meta">
        <span class="hub-cat">{entry.data.category}</span>
        <span>{fmt(entry.data.date)}</span>
        {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lede" style="max-width:none">{entry.data.description}</p>
    </div>
  </article>
  <section class="band" style="border-top:0;padding-top:28px">
    <div class="wrap" style="max-width:760px">
      <div class="prose"><Content /></div>
      {entry.data.cta && (
        <div class="art-cta">
          <a class="btn btn-primary btn-lg" href={entry.data.cta.href}>{entry.data.cta.label} <span class="arw">→</span></a>
        </div>
      )}
      <p class="art-back"><a href="/learn">← Back to the Learning Hub</a></p>
    </div>
  </section>
</main>
<style>
  .back{font-family:var(--font-mono);font-size:12px;color:var(--ink-3);text-decoration:none}
  .back:hover{color:var(--ember)}
  .art-meta{display:flex;gap:16px;font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-top:22px}
  .hub-cat{color:var(--ember)}
  .prose{color:var(--ink-2);font-size:1.05rem;line-height:1.7}
  .prose :global(h2){font-family:var(--font-display);color:var(--ink);font-size:1.5rem;font-weight:700;letter-spacing:-0.02em;margin:38px 0 14px}
  .prose :global(h3){font-family:var(--font-display);color:var(--ink);font-size:1.2rem;font-weight:600;margin:28px 0 10px}
  .prose :global(p){margin:0 0 18px}
  .prose :global(ul),.prose :global(ol){margin:0 0 18px;padding-left:22px;display:flex;flex-direction:column;gap:9px}
  .prose :global(li){padding-left:4px}
  .prose :global(a){color:var(--ember)}
  .prose :global(strong){color:var(--ink);font-weight:600}
  .art-cta{margin:38px 0 0;padding-top:28px;border-top:1px solid var(--line)}
  .art-back{margin-top:30px;font-family:var(--font-mono);font-size:12px}
  .art-back a{color:var(--ink-3);text-decoration:none}
</style>
</Base>
