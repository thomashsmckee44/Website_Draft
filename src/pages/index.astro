---
import Base from "../layouts/Base.astro";

const SITE = "https://www.tmdesignengineering.com";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE}/#webpage`,
    url: `${SITE}/`,
    name: "Thomas McKee, Design Engineer & Product Development Consultant, Edinburgh",
    isPartOf: { "@id": `${SITE}/#website` },
    about: { "@id": `${SITE}/#business` },
    description:
      "Design engineering and product development consultant in Edinburgh helping founders and startups take consumer hardware from concept to production.",
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Product development services",
    provider: { "@id": `${SITE}/#business` },
    itemListElement: [
      { "@type": "Service", name: "Power Hour", url: `${SITE}/services/power-hour` },
      { "@type": "Service", name: "Design Review", url: `${SITE}/services/design-review` },
      { "@type": "Service", name: "Feasibility Study", url: `${SITE}/services/feasibility-study` },
      { "@type": "Service", name: "Concept & MVP Development", url: `${SITE}/services/concept-mvp-development` },
      { "@type": "Service", name: "Design Verification", url: `${SITE}/services/design-verification` },
      { "@type": "Service", name: "Manufacturing Preparation", url: `${SITE}/services/manufacturing-preparation` },
      { "@type": "Service", name: "Product Development", url: `${SITE}/services/product-development` },
      { "@type": "Service", name: "Contract Engineering", url: `${SITE}/services/contract-engineering` },
    ],
  },
];
---
<Base
  title="Design Engineer, Edinburgh, Product Development | Thomas McKee"
  description="Design engineering and product development consultant in Edinburgh, UK. I help founders and startups take consumer hardware from concept to production, mechanical design, firmware and design for manufacture (DFM)."
  jsonld={jsonld}>
<main>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-lead">
        <span class="eyebrow">Design Engineering Consultant, Edinburgh, UK</span>
        <h1>Engineering Products from Concept to Manufacture</h1>
        <p class="lede">Providing design engineering expertise to entrepreneurs, founders and start-ups. Solving the hard technical problems and reducing the risk and cost in the product development process.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#contact">Book a free intro call <span class="arw">→</span></a>
          <a class="btn btn-ghost" href="#work">See the work</a>
        </div>
      </div>
      <aside class="titleblock" aria-label="Practitioner details">
        <div class="tb-head"><span>Drawing No. TMDE-001</span><span class="tb-dot" aria-hidden="true"></span></div>
        <div class="tb-row"><div class="tb-k">Engineer</div><div class="tb-v">Thomas McKee</div></div>
        <div class="tb-row"><div class="tb-k">Discipline</div><div class="tb-v">Design Engineering</div></div>
        <div class="tb-row"><div class="tb-k">Based</div><div class="tb-v">Edinburgh, UK</div></div>
        <div class="tb-row"><div class="tb-k">Prev.</div><div class="tb-v">4+ yrs · Ooni</div></div>
        <div class="tb-row"><div class="tb-k">Scope</div><div class="tb-v">Mech · Thermal · Structural · Firmware · UX · DFMA</div></div>
        <div class="tb-row"><div class="tb-k">Status</div><div class="tb-v avail">Available for projects</div></div>
      </aside>
    </div>
  </section>

  <!-- CREDIBILITY -->
  <div class="cred">
    <div class="wrap cred-inner">
      <span class="lbl">Shipped &amp; recognised</span>
      <span class="cred-item"><b>Ooni Volt 2</b> · Red Dot Design Award 2026</span>
      <span class="cred-item"><b>Ooni Karu 2</b> · iF Design Award 2024</span>
      <span class="cred-item"><b>Ooni Karu 2 Pro</b> · iF Design Award 2025</span>
      <span class="cred-item">3 patented or patent-pending inventions</span>
      <span class="cred-item">Sold worldwide</span>
    </div>
  </div>

  <div class="wrap">
    <!-- WORK -->
    <section id="work">
      <div class="sec-head no-rule">
        <div>
          <span class="idx">01 · Selected Work</span>
          <h2 class="sec-title" style="margin-top:12px">Previous Projects out there in the world</h2>
        </div>
      </div>
      <p class="sec-intro">I spent over 4 years at Ooni working across design, mechanical engineering, firmware, thermal performance, specialist testing, and manufacture for premium consumer products, of which many have reached the market and received international recognition or are in production stages. Some highlights shown below.</p>

      <div style="margin-top:8px">
        <!-- Case 1 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 01</span>
            <h3>Ooni Volt 2: Indoor Electric Pizza Oven</h3>
            <span class="role">Performance Hardware Designer · Firmware Development Lead · User Experience &amp; Product Validation</span>
            <p>Designing the function, user experience and performance of a compact indoor oven capable of reaching 450&nbsp;°C, via both hardware and firmware development. Building the patent-pending adaptive cooking firmware, a thermal-estimation algorithm for accurate stone control from a single sensor, and the oven hardware such as heating elements and inner shells.</p>
            <div class="tags">
              <span class="tag">Control systems</span>
              <span class="tag">Thermal modelling</span>
              <span class="tag">Thermal simulation</span>
              <span class="tag">UI/UX</span>
              <span class="tag">Firmware</span>
              <span class="tag">Heating element design</span>
              <span class="tag">High-performance design</span>
              <span class="tag">Design for manufacture</span>
              <span class="tag">Safety compliance</span>
              <span class="tag">Part &amp; subassembly design</span>
              <span class="tag">Product validation</span>
              <span class="tag">Technical documentation</span>
            </div>
            <p style="margin-top:18px"><a href="/work/ooni-volt-2" style="color:var(--ember);font-family:var(--font-mono);font-size:13px;letter-spacing:.02em">Read the full case study →</a></p>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>Red Dot Design Award</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>Pizza Intelligence™</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>20–450 °C</b> temperature range</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>30%</b> smaller footprint</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>70%</b> better stone temperature distribution</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>23%</b> faster heat-up with a <b>64%</b> larger window</span></div>
          </div>
        </article>

        <!-- Case 2 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 02</span>
            <h3>Ooni Karu 2: Multi-Fuel Outdoor Pizza Oven</h3>
            <span class="role">Performance optimisation · Door design &amp; sub-assembly · Verification &amp; test</span>
            <p>I redesigned an expensive, hard-to-manufacture and low-performing glass pizza oven door to invent the patented <b>ClearView™</b> technology. I solved high-temperature magnetic latching through flux-path analysis, and tuned multi-fuel airflow and chimney thermal safety to stay compliant across every fuel type, whilst boosting performance and efficiency.</p>
            <div class="tags">
              <span class="tag">Door design</span>
              <span class="tag">Mechanism design</span>
              <span class="tag">DFM / DFA</span>
              <span class="tag">Sheet metal design</span>
              <span class="tag">Casting design</span>
              <span class="tag">Injection moulding design</span>
              <span class="tag">CFD / airflow</span>
              <span class="tag">Combustion optimisation</span>
              <span class="tag">Thermal simulation</span>
              <span class="tag">Structural simulation</span>
              <span class="tag">Magnetics</span>
              <span class="tag">Specialised testing</span>
              <span class="tag">User testing</span>
              <span class="tag">Compliance</span>
              <span class="tag">Technical documentation</span>
            </div>
            <p style="margin-top:18px"><a href="/work/ooni-karu-2" style="color:var(--ember);font-family:var(--font-mono);font-size:13px;letter-spacing:.02em">Read the full case study →</a></p>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>iF Design Award 2024</b> · German Design Award 2024</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>~70%</b> BOM reduction, larger viewing window</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Assembly time from <b>24 h → &lt;2 mins</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">ClearView™ scaled to iF-winning <b>Karu 2 Pro</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>−27%</b> solid fuel consumption vs the previous generation</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>4.7★</b> across 1,700+ customer reviews</span></div>
          </div>
        </article>

        <!-- Case 3 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 03</span>
            <h3>Ooni Dough Proofing Boxes</h3>
            <span class="role">Design Engineer · from concept to production</span>
            <p>A deceptively simple stackable, nestable proofing system, but with a tightly constrained architecture including regional fridge envelopes, nesting draft, large-format injection moulding and tolerance stack-up across every stacked state. I formalised the competing constraints into a trade-off model, conceptualised the industrial design, and took them through verification, DFM and manufacture.</p>
            <div class="tags">
              <span class="tag">Industrial design</span>
              <span class="tag">Concept design</span>
              <span class="tag">Geometric design</span>
              <span class="tag">Constraint modelling</span>
              <span class="tag">Tolerance analysis</span>
              <span class="tag">Injection moulding design</span>
              <span class="tag">Structural simulation</span>
              <span class="tag">DFM / DFA</span>
              <span class="tag">Manufacturing optimisation</span>
              <span class="tag">Range compatibility</span>
              <span class="tag">Verification &amp; test</span>
              <span class="tag">Technical documentation</span>
            </div>
            <p style="margin-top:18px"><a href="/work/ooni-dough-proofing-boxes" style="color:var(--ember);font-family:var(--font-mono);font-size:13px;letter-spacing:.02em">Read the full case study →</a></p>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Sold by Ooni for <b>3+ years</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Predicted <b>scrappage</b> borne out in production</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Large-format injection moulding, <b>single-shot</b> tooling</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>4.8★</b> across 460+ reviews</span></div>
          </div>
        </article>
      </div>
      <div class="moreproj">
        <div class="mp-lbl">Beyond consumer products, selected analysis &amp; modelling</div>
        <div class="mp-grid">
          <a class="mp" href="/work/water-rocket"><h4>Water Rocket, engineering analysis</h4><p>First-principles rocket model implementing thermodynamics, compressible nozzle flow and flight dynamics, validated to ±5% and optimised entirely in software.</p></a>
          <a class="mp" href="/work/femur-structural-analysis"><h4>Femur Structural Analysis, research paper</h4><p>Patient-specific FEA for better health outcomes. Predicting bone fracture risk from a clinical CT scan, with a novel boundary condition benchmarked against cadaver tests.</p></a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services">
      <div class="sec-head">
        <div>
          <span class="idx">02 · Services</span>
          <h2 class="sec-title" style="margin-top:12px">How I can help you in your project</h2>
        </div>
      </div>
      <p class="sec-intro">Your specific needs aren't one size fits all, you can start with a single fixed-scope service, or hire me to run the full journey from the seed of an idea to the product in a shipping container.</p>

      <a class="svc-flag" href="/services/product-development" style="display:block;margin-top:28px;border:1px solid var(--ember);border-radius:16px;background:var(--surface);padding:clamp(22px,3vw,32px);position:relative;overflow:hidden;text-decoration:none">
        <span style="position:absolute;inset:0;background:radial-gradient(120% 160% at 100% 0%,var(--ember-tint),transparent 55%);pointer-events:none"></span>
        <div style="position:relative">
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><span style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-3)">The full journey, idea to production</span></div>
          <h3 style="margin-top:14px;font-size:clamp(1.4rem,2.6vw,1.9rem);letter-spacing:-0.02em">Product Development</h3>
          <p class="sub" style="max-width:70ch">One experienced engineer owning the path from a first idea to a product that's ready to manufacture, bringing in a trusted network of specialists as the product needs them. Delivered in scoped, gated phases, so you commit one step at a time. The standalone services below are each a phase of this.</p>
          <span style="display:inline-flex;align-items:center;gap:8px;margin-top:6px;font-family:var(--font-mono);font-size:13px;color:var(--ember)">Explore Product Development <span class="arw">→</span></span>
        </div>
      </a>

      <div class="svc-grid" style="margin-top:18px">
        <a class="svc" href="/services/feasibility-study">
          <div class="svc-top"><span class="svc-num">01</span><span class="svc-stage">from £650</span></div>
          <h3>Feasibility Study</h3>
          <p class="sub">Technical validation is as important as commercial validation, know if it can be built, and the costs involved, before real investment.</p>
          <div class="deliv"><span>Feasibility report</span><span>Routes to manufacture</span><span>Design directions</span></div>
        </a>
        <a class="svc" href="/services/concept-mvp-development">
          <div class="svc-top"><span class="svc-num">02</span><span class="svc-stage">Founder favourite</span></div>
          <h3>Concept &amp; MVP Development</h3>
          <p class="sub">Turn an idea into a working MVP you can show users, test and raise investment with.</p>
          <div class="deliv"><span>Working MVP</span><span>Iterative prototypes</span><span>Plan to production</span></div>
        </a>
        <a class="svc" href="/services/design-verification">
          <div class="svc-top"><span class="svc-num">03</span><span class="svc-stage">Service</span></div>
          <h3>Design Verification</h3>
          <p class="sub">Design review, engineering analysis, simulation and specialist testing before you commit to tooling.</p>
          <div class="deliv"><span>Design verification plan</span><span>Simulation reports</span><span>Test reports</span></div>
        </a>
        <a class="svc" href="/services/manufacturing-preparation">
          <div class="svc-top"><span class="svc-num">04</span><span class="svc-stage">Service</span></div>
          <h3>Manufacturing Preparation</h3>
          <p class="sub">Making a product ready for efficient, volume manufacture to save initial tooling investment and long-term production costs.</p>
          <div class="deliv"><span>DFMA report</span><span>Production drawings, GD&amp;T</span><span>Tolerance analysis</span></div>
        </a>
      </div>

      <div class="engage">
        <a class="eng" href="/services/power-hour"><div class="h">Power Hour, from £50</div><div class="d">Low-commitment expert eyes on your problem, in-person or online. The easiest way to start.</div></a>
        <a class="eng" href="/services/design-review"><div class="h">Design Review, from £200</div><div class="d">A half-day workshop review of your design or concept, with a written report afterwards.</div></a>
        <a class="eng" href="/services/contract-engineering"><div class="h">Contract Engineering</div><div class="d">Specialist or extra engineering capacity for projects that already have a scope.</div></a>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about">
      <div class="sec-head">
        <div>
          <span class="idx">03 · About</span>
          <h2 class="sec-title" style="margin-top:12px">A design engineer who's shipped the hard stuff</h2>
        </div>
      </div>
      <div class="about-grid">
        <div class="about-body">
          <p>I spent over four years designing high-end consumer products at Ooni, working on projects from first concept and taking them through to volume manufacture. I've produced production parts, sub-assemblies and assemblies, and developed both the UI and functional production firmware. That experience gave me a practical understanding of what it actually takes to <strong>ship real products</strong>. Performance, cost, safety and manufacturability must all be balanced while working within tight timelines and development budgets.</p>
          <p>Today I work as an independent design engineer and product-development consultant to founders and start-ups. Many have a strong product vision but limited access to experienced engineering. One key aspect of my work is providing <strong>structure and rhythm</strong> to the design process, challenging initial assumptions to future-proof design work, and holding a steady plan that balances the costs of development with reducing risk in investment. When a problem is hard, I stay with it: some of the work I'm proudest of took months of pushing, internally and with suppliers, to get right.</p>
          <p>Throughout my work, I try to explain the engineering clearly, <strong>without gatekeeping the technical aspects</strong>, so you know exactly why the decisions and trade-offs are made.</p>
          <p>Alongside commercial work, I give part of my time to <strong>pro-bono engineering</strong> for projects with social or environmental impact. I think engineering should be used in a meaningful way and be a force for good. This philosophy affects all of my work.</p>
        </div>
        <div class="values" aria-label="Values">
          <div class="val"><div class="vh"><span class="n">01</span> Integrity</div><div class="vd">Decisions are evidence based and transparent, with clear communication on where trade-offs need to be made.</div></div>
          <div class="val"><div class="vh"><span class="n">02</span> Thoughtful Innovation</div><div class="vd">Creative solutions to practical engineering problems that aren't complex for the sake of complexity.</div></div>
          <div class="val"><div class="vh"><span class="n">03</span> Long-Term Solutions</div><div class="vd">In both design and process, ensuring early work is done properly to reduce the risk of re-work.</div></div>
          <div class="val"><div class="vh"><span class="n">04</span> Positive Impact</div><div class="vd">Engineering should be a force for good, used meaningfully whether in a commercial or pro-bono setting.</div></div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section id="testimonials">
      <div class="sec-head">
        <div>
          <span class="idx">04 · In Their Words</span>
          <h2 class="sec-title" style="margin-top:12px">What people I work with said</h2>
        </div>
      </div>
      <p class="sec-intro">A few words from colleagues I worked with at Ooni.</p>
      <div class="treel-wrap" data-treel>
        <div class="treel">
          <figure class="treel-card"><blockquote>&ldquo;He is a genius!&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;Tom was the mastermind and driving force behind the Volt 2's operating system, virtually building it single-handedly from the ground up.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;His contributions to Volt 2 have ensured it is not only a massive step forward but a clear leap ahead of the competition.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;His work consistently demonstrates a rare blend of deep technical insight, creative problem-solving, and practical innovation.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;The way he deconstructs complex problems, whether mapping application layers or analysing how a pizza cooks through energy flow and thermodynamics, reflects an exceptional mind at work.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;He demonstrated exceptional dedication, battling for months both internally and externally to make that complex vision a reality, and he succeeded.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;His product knowledge is excellent, and he possesses an unwavering clarity on the standards that define truly good design.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;He can seamlessly deliver technical details at the exact right level for any audience, a critical skill in this game.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;A major contributor to some of Ooni's most successful and technically complex products.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;The room genuinely listens when you speak.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;His definition of the application-layer architecture stands as the gold standard for how such systems should be mapped.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;His idea to [redacted], on the [redacted] system, was a master stroke, blending scientific thinking with real-world improvement.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
          <figure class="treel-card"><blockquote>&ldquo;Tom's impact is profound; he will be greatly missed.&rdquo;</blockquote><figcaption>- Colleague, Ooni</figcaption></figure>
        </div>
        <div class="treel-nav">
          <button class="tcar-btn" type="button" data-treel-prev aria-label="Previous testimonials">&larr;</button>
          <button class="tcar-btn" type="button" data-treel-next aria-label="Next testimonials">&rarr;</button>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <!--
      SETUP, two free accounts, ~5 minutes each, then paste two values below:
      1) FORM  → web3forms.com : enter your email, copy the Access Key, and replace
                 REPLACE_WITH_WEB3FORMS_ACCESS_KEY (in the hidden input) with it.
                 Submissions then arrive straight to your inbox. Nothing else to host.
      2) CALENDAR → cal.com : create a free account + an event type (e.g. "Intro call, 30 min"),
                 then replace REPLACE_WITH_CALCOM_LINK on the "Book a slot" button below with your
                 link path, e.g. thomas-mckee/intro  (just the path, no https://cal.com/)
    -->
    <section id="contact">
      <div class="contact">
        <div class="inner" style="max-width:none">
          <span class="eyebrow">Let's talk</span>
          <h2 style="margin-top:16px">Have an idea you want to turn into a real product?</h2>
          <p>Take your first step now! Get in touch with a message or book a call and tell me about your idea, whether it's a first concept or a full design that needs to be made manufacturable. I'll tell you whether I can help and where.</p>
          <div class="contact-cols">
            <div class="cbox">
              <h3>Send a message</h3>
              <form id="contact-form">
                <input type="hidden" name="access_key" value="c81a57ca-ff61-48ee-ae8f-d27d37ef6979" />
                <input type="hidden" name="subject" value="New enquiry from tmdesignengineering.com" />
                <input type="hidden" name="from_name" value="TMDE website" />
                <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
                <div class="field"><label for="cf-name">Name</label><input id="cf-name" type="text" name="name" required /></div>
                <div class="field"><label for="cf-email">Email</label><input id="cf-email" type="email" name="email" required /></div>
                <div class="field"><label for="cf-phone">Phone <span class="opt">(optional)</span></label><input id="cf-phone" type="tel" name="phone" /></div>
                <div class="field"><label for="cf-msg">Your query</label><textarea id="cf-msg" name="message" required placeholder="A sentence or two on your idea or product and where you'd like help."></textarea></div>
                <button class="btn btn-primary btn-lg" type="submit">Send message <span class="arw">→</span></button>
                <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
              </form>
            </div>
            <div class="cbox book-card">
              <h3>Book a free intro call</h3>
              <p class="hint">No obligation · video or phone · up to 45 minutes</p>
              <ul>
                <li>Talk through where you are and what a sensible first step looks like</li>
                <li>Get an honest view on whether and where I can help</li>
                <li>Pick a slot that suits you and you'll get a calendar invite</li>
              </ul>
              <button class="btn btn-primary btn-lg" data-cal-link="thomasmckeedesignengineering/intro-call" data-cal-namespace="intro" data-cal-config='{"layout":"month_view"}'>Book a slot <span class="arw">→</span></button>
            </div>
          </div>
          <div class="row" style="margin-top:22px">
            <a class="mailto" href="mailto:thomas.h.s.mckee@outlook.com">…or email me directly: thomas.h.s.mckee@outlook.com</a>
          </div>
        </div>
      </div>
    </section>
  </div>

</main>

<style>
