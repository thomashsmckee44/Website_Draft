<script is:inline>
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (form.id !== 'contact-form') return;
    e.preventDefault();
    var status = document.getElementById('form-status');
    var btn = form.querySelector('button[type=submit]');
    var data = Object.fromEntries(new FormData(form));
    btn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'form-status';
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data)
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (j.success) {
        form.reset();
        status.textContent = "Thanks, your message is on its way. I'll get back to you as soon as I can.";
        status.className = 'form-status ok';
      } else {
        status.textContent = 'Something went wrong: ' + (j.message || 'please try again, or email me directly.');
        status.className = 'form-status err';
      }
      btn.disabled = false;
    }).catch(function () {
      status.textContent = "Couldn't send just now. Please email me directly at thomas.h.s.mckee@outlook.com.";
      status.className = 'form-status err';
      btn.disabled = false;
    });
  });
</script>

<script is:inline>
  (function () {
    var wrap = document.querySelector('[data-treel]');
    if (!wrap) return;
    var reel = wrap.querySelector('.treel');
    if (!reel) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = null;
    function step(dir) {
      var card = reel.querySelector('.treel-card');
      if (!card) return;
      var w = card.getBoundingClientRect().width + 16;
      if (dir > 0 && reel.scrollLeft + reel.clientWidth >= reel.scrollWidth - 4) {
        reel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        reel.scrollBy({ left: dir * w, behavior: 'smooth' });
      }
    }
    function reset() { if (timer) clearInterval(timer); if (!reduce) timer = setInterval(function () { step(1); }, 4500); }
    var next = wrap.querySelector('[data-treel-next]'), prev = wrap.querySelector('[data-treel-prev]');
    if (next) next.addEventListener('click', function () { step(1); reset(); });
    if (prev) prev.addEventListener('click', function () { step(-1); reset(); });
    wrap.addEventListener('mouseenter', function () { if (timer) clearInterval(timer); });
    wrap.addEventListener('mouseleave', reset);
    reset();
  })();
</script>

