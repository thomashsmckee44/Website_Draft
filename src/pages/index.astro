---
import Base from "../layouts/Base.astro";

const SITE = "https://www.tmdesignengineering.com";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE}/#webpage`,
    url: `${SITE}/`,
    name: "Thomas McKee — Design Engineer & Product Development Consultant, Edinburgh",
    isPartOf: { "@id": `${SITE}/#website` },
    about: { "@id": `${SITE}/#business` },
    description:
      "Design engineering and product development consultant in Edinburgh helping founders and startups take consumer hardware from concept to production.",
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Product development services",
    provider: { "@id": `${SITE}/#business` },
    itemListElement: [
      { "@type": "Service", name: "Feasibility Study", url: `${SITE}/services/feasibility-study` },
      { "@type": "Service", name: "Concept & MVP Development", url: `${SITE}/services/concept-mvp-development` },
      { "@type": "Service", name: "Engineering Verification", url: `${SITE}/services/engineering-verification` },
      { "@type": "Service", name: "Manufacturing Preparation", url: `${SITE}/services/manufacturing-preparation` },
    ],
  },
];
---
<Base
  title="Design Engineer, Edinburgh — Product Development | Thomas McKee"
  description="Design engineering and product development consultant in Edinburgh, UK. I help founders and startups take consumer hardware from concept to production — mechanical design, firmware and design for manufacture (DFM)."
  jsonld={jsonld}>
<main>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-lead">
        <span class="eyebrow">Design Engineering Consultant · Edinburgh, UK</span>
        <h1>Consumer hardware,<br>engineered to <em>reach the shelf.</em></h1>
        <p class="lede">I take product ideas from first sketch to the shelf — seeing the mechanical design, firmware and manufacture as one system. I help founders and startups de-risk the hard engineering early and keep momentum, so good ideas survive the journey to a real, shipped product.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#contact">Book a free intro call <span class="arw">→</span></a>
          <a class="btn btn-ghost" href="#work">See the work</a>
        </div>
      </div>
      <aside class="titleblock" aria-label="Practitioner details">
        <div class="tb-head"><span>Drawing No. TMDE—001</span><span class="tb-dot" aria-hidden="true"></span></div>
        <div class="tb-row"><div class="tb-k">Engineer</div><div class="tb-v">Thomas McKee</div></div>
        <div class="tb-row"><div class="tb-k">Discipline</div><div class="tb-v">Design Engineering</div></div>
        <div class="tb-row"><div class="tb-k">Based</div><div class="tb-v">Edinburgh, UK</div></div>
        <div class="tb-row"><div class="tb-k">Prev.</div><div class="tb-v">4+ yrs · Ooni</div></div>
        <div class="tb-row"><div class="tb-k">Scope</div><div class="tb-v">Mech · Firmware · DFM</div></div>
        <div class="tb-row"><div class="tb-k">Status</div><div class="tb-v avail">Available for projects</div></div>
      </aside>
    </div>
  </section>

  <!-- CREDIBILITY -->
  <div class="cred">
    <div class="wrap cred-inner">
      <span class="lbl">Shipped &amp; recognised —</span>
      <span class="cred-item"><b>Ooni Volt 2</b> · Red Dot Design Award 2026</span>
      <span class="cred-item"><b>Ooni Karu 2</b> · iF Design Award 2024</span>
      <span class="cred-item">2 patent-pending technologies</span>
      <span class="cred-item">Featured in <b>Oprah's Favourite Things</b></span>
      <span class="cred-item">Sold in John Lewis &amp; worldwide</span>
    </div>
  </div>

  <div class="wrap">
    <!-- WORK -->
    <section id="work">
      <div class="sec-head no-rule">
        <div>
          <span class="idx">01 — Selected Work</span>
          <h2 class="sec-title" style="margin-top:12px">Products I've helped ship</h2>
        </div>
      </div>
      <p class="sec-intro">Four years at Ooni, working across mechanical design, firmware and manufacturing on premium consumer products that reached the shelf and won international recognition. Three that show the range:</p>

      <div style="margin-top:8px">
        <!-- Case 1 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 01</span>
            <h3>Ooni Volt 2 — Electric Pizza Oven</h3>
            <span class="role">Performance architecture · Firmware · Validation</span>
            <p>I owned the performance and control system of a compact indoor oven that reaches 450&nbsp;°C. I stepped into firmware to build the patent-pending <b>Pizza Intelligence™</b> adaptive cooking system, developed a thermal-estimation algorithm that holds accurate stone temperature from a single sensor, and designed the performance-critical cavity hardware and heating elements behind it.</p>
            <div class="tags">
              <span class="tag">Control systems</span>
              <span class="tag">Thermal modelling</span>
              <span class="tag">UI firmware</span>
              <span class="tag">Heating elements</span>
              <span class="tag">Safety compliance</span>
            </div>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Launched <b>October 2025</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Featured in <b>Oprah's Favourite Things</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Patent-pending <b>Pizza Intelligence™</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>500+</b> pizzas cooked in testing</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Delivered <b>on time &amp; on budget</b></span></div>
          </div>
        </article>

        <!-- Case 2 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 02</span>
            <h3>Ooni Karu 2 — Multi-Fuel Pizza Oven</h3>
            <span class="role">Performance optimisation · Door sub-assembly</span>
            <p>I rethought the glass-door architecture to create <b>ClearView™</b> — a patent-pending anti-soot geometry that improved visibility while cutting cost and complexity at the same time. I solved high-temperature magnetic latching through flux-path analysis, and tuned multi-fuel airflow and chimney thermal safety to stay compliant across every fuel type.</p>
            <div class="tags">
              <span class="tag">Sheet-metal DFM</span>
              <span class="tag">Combustion tuning</span>
              <span class="tag">Thermal simulation</span>
              <span class="tag">Magnetics</span>
              <span class="tag">User testing</span>
            </div>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>iF Design Award 2024</b> · German Design Awards 2024</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Double-digit&nbsp;% <b>BOM cost reduction</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt"><b>24h+</b> assembly time saved per batch</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">ClearView™ scaled to flagship <b>Karu 2 Pro</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Stocked in <b>John Lewis</b> &amp; major retailers</span></div>
          </div>
        </article>

        <!-- Case 3 -->
        <article class="case">
          <div>
            <span class="case-idx">CASE 03</span>
            <h3>Ooni Dough Proofing Boxes</h3>
            <span class="role">Design engineering · Concept to production</span>
            <p>A deceptively simple stackable, nestable proofing system hiding a tightly constrained architecture — regional fridge envelopes, nesting draft, large-format injection moulding and tolerance stack-up across every stacked state. I formalised the competing constraints into a trade-off model, turning stakeholder debate into structured decisions made <em>before</em> committing to steel.</p>
            <div class="tags">
              <span class="tag">Injection moulding</span>
              <span class="tag">Tolerance analysis</span>
              <span class="tag">Constraint modelling</span>
              <span class="tag">DFM</span>
            </div>
          </div>
          <div class="outcomes">
            <div class="oc-lbl">Outcomes</div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Sold by Ooni for <b>3+ years</b></span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Tolerance strategy targeting <b>&lt;1%</b> stack failure</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Large-format injection moulding, <b>single-shot</b> tooling</span></div>
            <div class="oc"><span class="mk">◆</span><span class="txt">Consistently <b>strong customer ratings</b></span></div>
          </div>
        </article>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services">
      <div class="sec-head">
        <div>
          <span class="idx">02 — Services</span>
          <h2 class="sec-title" style="margin-top:12px">How I help you ship</h2>
        </div>
      </div>
      <p class="sec-intro">Start with a single fixed-scope service, or bring me in for the full journey from idea to shelf. The earlier the hard engineering is de-risked, the cheaper every later decision becomes.</p>

      <div class="svc-grid" style="margin-top:28px">
        <a class="svc" href="/services/feasibility-study">
          <div class="svc-top"><span class="svc-num">01</span><span class="svc-stage">from £650</span></div>
          <h3>Feasibility Study</h3>
          <p class="sub">Know if your idea can be built — the risks, the rough cost and the timeline — before you spend real money.</p>
          <div class="deliv"><span>Concept exploration</span><span>Technology review</span><span>Risk analysis</span></div>
        </a>
        <a class="svc" href="/services/concept-mvp-development">
          <div class="svc-top"><span class="svc-num">02</span><span class="svc-stage">Founder favourite</span></div>
          <h3>Concept &amp; MVP Development</h3>
          <p class="sub">Turn an idea into an evaluated, buildable concept and a working MVP you can put in front of users, investors or a crowd.</p>
          <div class="deliv"><span>Concept &amp; evaluation</span><span>Prototyping</span><span>A working MVP</span></div>
        </a>
        <a class="svc" href="/services/engineering-verification">
          <div class="svc-top"><span class="svc-num">03</span><span class="svc-stage">Service</span></div>
          <h3>Engineering Verification</h3>
          <p class="sub">Prove a design works and is safe — engineering analysis, simulation and structured testing — before committing to tooling.</p>
          <div class="deliv"><span>Engineering analysis</span><span>Simulation</span><span>Testing</span></div>
        </a>
        <a class="svc" href="/services/manufacturing-preparation">
          <div class="svc-top"><span class="svc-num">04</span><span class="svc-stage">Service</span></div>
          <h3>Manufacturing Preparation</h3>
          <p class="sub">Get a finished design ready for efficient, medium-to-high-volume manufacture, coordinating suppliers in the UK and China.</p>
          <div class="deliv"><span>DFM / DFA review</span><span>Manufacturing drawings</span><span>Supplier liaison</span></div>
        </a>
      </div>

      <div class="engage">
        <div class="eng"><div class="h">Start here — from £50</div><div class="d">A Power Hour or a fixed-price Design Review: low-commitment expert eyes, live or online.</div></div>
        <div class="eng"><div class="h">Product Development</div><div class="d">The full managed journey, concept to production, delivered in scoped phases.</div></div>
        <div class="eng"><div class="h">Contract Engineering</div><div class="d">Specialist or extra engineering capacity for teams that already know the scope.</div></div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about">
      <div class="sec-head">
        <div>
          <span class="idx">03 — About</span>
          <h2 class="sec-title" style="margin-top:12px">A design engineer who's shipped the hard stuff</h2>
        </div>
      </div>
      <div class="about-grid">
        <div class="about-body">
          <p>I spent over four years developing high-end consumer products at Ooni, taking projects from first concept through to volume manufacture. Because I've held mechanical, firmware and thermal roles at once, I see how a decision in one ripples through all the others — the <strong>whole-picture view</strong> that turns the usual time-versus-cost-versus-performance trade-off into the occasional moment where all three improve together.</p>
          <p>Today I work as an independent design engineer and product development consultant to founders and startups. Many have a strong product vision but limited access to experienced engineering. What I've found matters most is <strong>structure and rhythm</strong> — walking first-timers through the real development process, then running a steady plan with fast, honest prototyping that keeps momentum without losing the essence of the idea to endless late changes. And whoever I'm working with, the thing I lean on hardest is being able to <strong>explain the engineering clearly</strong> — the decisions, the trade-offs, the occasional physically impossible spec — in plain terms.</p>
          <p>Alongside commercial work, I dedicate part of my time to <strong>pro-bono engineering</strong> for initiatives with social or environmental impact. I believe good engineering should contribute beyond commercial success — so by working with me, you help support that too.</p>
        </div>
        <div class="values" aria-label="Values">
          <div class="val"><div class="vh"><span class="n">01</span> Integrity</div><div class="vd">Decisions made transparent and backed by evidence, so teams can move with confidence.</div></div>
          <div class="val"><div class="vh"><span class="n">02</span> Thoughtful Innovation</div><div class="vd">Creative solutions grounded in practical engineering — never complexity for its own sake.</div></div>
          <div class="val"><div class="vh"><span class="n">03</span> Long-Term Solutions</div><div class="vd">Designed for lifecycle, sustainability and real-world use from the very start.</div></div>
          <div class="val"><div class="vh"><span class="n">04</span> Positive Impact</div><div class="vd">Engineering that contributes beyond the balance sheet, in client work and pro-bono alike.</div></div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <!--
      SETUP — two free accounts, ~5 minutes each, then paste two values below:
      1) FORM  → web3forms.com : enter your email, copy the Access Key, and replace
                 REPLACE_WITH_WEB3FORMS_ACCESS_KEY (in the hidden input) with it.
                 Submissions then arrive straight to your inbox. Nothing else to host.
      2) CALENDAR → cal.com : create a free account + an event type (e.g. "Intro call, 30 min"),
                 then replace REPLACE_WITH_CALCOM_LINK on the "Book a slot" button below with your
                 link path, e.g. thomas-mckee/intro  (just the path, no https://cal.com/)
    -->
    <section id="contact">
      <div class="contact">
        <div class="inner" style="max-width:none">
          <span class="eyebrow">Let's talk</span>
          <h2 style="margin-top:16px">Have a product that needs to become real?</h2>
          <p>Tell me where you're stuck — a first concept, or a design that needs to survive manufacturing — and I'll tell you honestly how I can help. Send a message, or grab a time in my calendar directly.</p>
          <div class="contact-cols">
            <div class="cbox">
              <h3>Send a message</h3>
              <p class="hint">I reply personally, usually within a day.</p>
              <form id="contact-form">
                <input type="hidden" name="access_key" value="c81a57ca-ff61-48ee-ae8f-d27d37ef6979" />
                <input type="hidden" name="subject" value="New enquiry from tmdesignengineering.com" />
                <input type="hidden" name="from_name" value="TMDE website" />
                <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
                <div class="field"><label for="cf-name">Name</label><input id="cf-name" type="text" name="name" required /></div>
                <div class="field"><label for="cf-email">Email</label><input id="cf-email" type="email" name="email" required /></div>
                <div class="field"><label for="cf-phone">Phone <span class="opt">(optional)</span></label><input id="cf-phone" type="tel" name="phone" /></div>
                <div class="field"><label for="cf-msg">Your query</label><textarea id="cf-msg" name="message" required placeholder="A sentence or two on your idea or product and where you'd like help."></textarea></div>
                <button class="btn btn-primary btn-lg" type="submit">Send message <span class="arw">→</span></button>
                <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
              </form>
            </div>
            <div class="cbox book-card">
              <h3>Book a free intro call</h3>
              <p class="hint">30 minutes · video or phone · no obligation.</p>
              <ul>
                <li>Talk through where you are and what a sensible first step looks like</li>
                <li>An honest view on whether — and how — I can help</li>
                <li>Pick a slot that suits you and you'll get a calendar invite</li>
              </ul>
              <button class="btn btn-primary btn-lg" data-cal-link="thomasmckeedesignengineering/intro-call" data-cal-namespace="intro" data-cal-config='{"layout":"month_view"}'>Book a slot <span class="arw">→</span></button>
            </div>
          </div>
          <div class="row" style="margin-top:22px">
            <a class="mailto" href="mailto:thomas.h.s.mckee@outlook.com">…or email me directly: thomas.h.s.mckee@outlook.com</a>
          </div>
        </div>
      </div>
    </section>
  </div>

</main>

<style>
  .contact-cols{display:grid;grid-template-columns:1.25fr 1fr;gap:26px;margin-top:32px}
  @media(max-width:760px){.contact-cols{grid-template-columns:1fr}}
  .cbox{background:var(--surface);border:1px solid var(--line);border-radius:2px;padding:26px}
  .cbox h3{font-family:var(--font-display);font-size:1.15rem;font-weight:700;margin:0 0 4px}
  .cbox .hint{color:var(--ink-3);font-size:.88rem;margin:0 0 18px;font-family:var(--font-mono)}
  .field{margin-bottom:14px;display:flex;flex-direction:column;gap:6px}
  .field label{font-size:.78rem;font-family:var(--font-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--ink-2)}
  .field label .opt{color:var(--ink-3);text-transform:none;letter-spacing:0}
  .field input,.field textarea{font-family:var(--font-body);font-size:1rem;color:var(--ink);background:var(--surface-2);border:1px solid var(--line-2);border-radius:2px;padding:11px 12px;width:100%}
  .field input:focus,.field textarea:focus{outline:2px solid var(--focus);outline-offset:1px;border-color:var(--focus)}
  .field textarea{resize:vertical;min-height:110px}
  .hp{position:absolute;left:-9999px}
  .form-status{margin-top:12px;font-size:.9rem;color:var(--ink-2);min-height:1.2em}
  .form-status.ok{color:var(--ember)}
  .form-status.err{color:#c0392b}
  .book-card{display:flex;flex-direction:column}
  .book-card ul{list-style:none;padding:0;margin:0 0 22px;color:var(--ink-2);font-size:.95rem}
  .book-card li{padding:7px 0 7px 22px;position:relative;line-height:1.45}
  .book-card li::before{content:"→";position:absolute;left:0;color:var(--ember)}
  .book-card .btn{margin-top:auto;align-self:flex-start}
</style>

<script is:inline>
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (form.id !== 'contact-form') return;
    e.preventDefault();
    var status = document.getElementById('form-status');
    var btn = form.querySelector('button[type=submit]');
    var data = Object.fromEntries(new FormData(form));
    btn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'form-status';
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data)
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (j.success) {
        form.reset();
        status.textContent = "Thanks — your message is on its way. I'll reply personally, usually within a day.";
        status.className = 'form-status ok';
      } else {
        status.textContent = 'Something went wrong: ' + (j.message || 'please try again, or email me directly.');
        status.className = 'form-status err';
      }
      btn.disabled = false;
    }).catch(function () {
      status.textContent = "Couldn't send just now — please email me directly at thomas.h.s.mckee@outlook.com.";
      status.className = 'form-status err';
      btn.disabled = false;
    });
  });
</script>

<script is:inline>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "intro", { origin: "https://cal.com" });
  Cal.ns.intro("ui", { hideEventTypeDetails: false, layout: "month_view" });
</script>
</Base>
