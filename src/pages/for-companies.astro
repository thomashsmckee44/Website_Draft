---
import Base from "../layouts/Base.astro";
import "../styles/service.css";

const SITE = "https://www.tmdesignengineering.com";
const url = `${SITE}/for-companies`;
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: "For Product Teams & Companies, specialist contract engineering",
    isPartOf: { "@id": `${SITE}/#website` },
    about: { "@id": `${SITE}/#business` },
    description:
      "Specialist design engineering capacity for product teams: firmware-mechanical crossover, thermal, and design for manufacture, from an engineer who has shipped consumer hardware at volume.",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "For Product Teams", item: url },
    ],
  },
];
---
<Base
  title="For Product Teams, Specialist Contract Engineering | Thomas McKee"
  description="Specialist or extra design engineering capacity for product teams: firmware-mechanical crossover, thermal systems, high-temperature design and DFM, from an engineer who has taken consumer products to volume manufacture."
  type="website"
  jsonld={jsonld}>
<main>
  <!-- HERO -->
  <section class="svc-hero">
    <div class="wrap">
      <span class="eyebrow">For product teams &amp; companies</span>
      <h1>A specialist engineer <em>for your team</em></h1>
      <p class="lede">Sometimes a project needs a specific depth of engineering that's hard to hire for, or a safe pair of senior hands to hit a deadline. I bring award-winning consumer product experience across mechanical, firmware, thermal and manufacture, and an understanding of how they integrate, to teams that need it.</p>
      <div class="svc-hero-cta">
        <a class="btn btn-primary" href="/#contact">Discuss a contract <span class="arw">→</span></a>
        <a class="btn btn-ghost" href="/#work">See my work</a>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">If this sounds like your team</span>
      <h2 class="sec-title">When you need expertise you don't have in house</h2>
      <div class="pain">
        <div class="q"><span class="mk">?</span><p>"We've hit a hard problem, thermal, firmware-mechanical, DFM, that we can't crack in-house."</p></div>
        <div class="q"><span class="mk">?</span><p>"We're a specialist short with a deadline closing, and need experienced capacity fast."</p></div>
        <div class="q"><span class="mk">?</span><p>"We want someone who has actually shipped consumer hardware at volume."</p></div>
      </div>
      <p class="sec-intro">For teams, the decision usually comes down to immediate impact. If you're a design agency that needs engineering expertise on a project, or an in-house product team that needs more resource, I can offer impact from day one without the need for a full hire.</p>
    </div>
  </section>

  <!-- PROOF -->
  <section class="band">
    <div class="wrap">
      <span class="sec-idx">The proof</span>
      <h2 class="sec-title">Shipped, acclaimed and patent-protected work</h2>
      <div class="proof">
        <div class="pl">Track record</div>
        <p>My work has reached the shelf and been recognised for it: I led the performance hardware and firmware development on the <strong>Red Dot-winning Ooni Volt 2</strong>, and designed the door and optimised the performance of the <strong>iF and German Design Award-winning Ooni Karu 2</strong>, whose architecture carried onto the iF-winning Karu 2 Pro. I'm named on patented and patent-pending inventions, and I've taken products through tooling and volume manufacture, on the factory floor when they were built, in the UK and overseas.</p>
      </div>
      <div class="svc-cred">
        <span class="ci"><b>Whole-picture</b>: mechanical, firmware, thermal &amp; manufacture as one system</span>
        <span class="ci"><b>Factory-floor depth</b>: tooling, first articles &amp; volume, UK &amp; China</span>
        <span class="ci"><b>Lower lifetime cost</b>: efficient, manufacture-ready design</span>
      </div>
      <p class="sec-intro" style="margin-top:26px"><a href="/#work" style="color:var(--ember)">See the case studies →</a></p>
    </div>
  </section>

  <!-- HOW I HELP -->
  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">How I plug in</span>
      <h2 class="sec-title">Capacity and specialist depth</h2>
      <p class="sec-intro">Engage me for ongoing capacity against your backlog, or for a specific, scoped piece of hard engineering.</p>
      <div class="aud-grid">
        <a class="aud" href="/services/contract-engineering">
          <div class="aud-top"><h3>Contract Engineering</h3><span class="aud-tag">For teams</span></div>
          <p>Day-rate or retained capacity, acting as an extension of your team on a defined brief. Specialist skills on tap: firmware and mechanical crossover, thermal and high-temperature systems, DFM.</p>
          <span class="aud-go">Contract Engineering <span class="arw">→</span></span>
        </a>
        <a class="aud" href="/services/design-verification">
          <div class="aud-top"><h3>Design Verification</h3></div>
          <p>Independent analysis, simulation and structured testing to prove a design before you commit to tooling, or to answer a specific engineering question.</p>
          <span class="aud-go">Design Verification <span class="arw">→</span></span>
        </a>
        <a class="aud" href="/services/manufacturing-preparation">
          <div class="aud-top"><h3>Manufacturing Preparation</h3></div>
          <p>DFMA, production CAD, a drawing pack with GD&amp;T and tolerance analysis to get a design efficient and repeatable at volume, and technical liaison with your factory.</p>
          <span class="aud-go">Manufacturing Preparation <span class="arw">→</span></span>
        </a>
        <a class="aud" href="/services/design-review">
          <div class="aud-top"><h3>Design Review</h3><span class="aud-price">from £200</span></div>
          <p>A fast, senior second opinion on a design or a decision, with a written report. A low-friction way to get expert eyes on something before it goes further.</p>
          <span class="aud-go">Design Review <span class="arw">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band" id="start">
    <div class="wrap">
      <div class="cta">
        <div class="inner">
          <span class="eyebrow">Let's talk</span>
          <h2 style="margin-top:14px">Need specialist engineering capacity?</h2>
          <p>Tell me the scope, the timeline and how your team works. I'll let you know how I can help, how quickly I can start, and what it costs.</p>
          <div class="row">
            <a class="btn btn-primary btn-lg" href="/#contact">Discuss a contract <span class="arw">→</span></a>
            <span class="price-tag">Remote or on-site · UK &amp; overseas</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<style>
  .aud-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:26px}
  @media(max-width:760px){.aud-grid{grid-template-columns:1fr}}
  .aud{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:24px 26px;text-decoration:none;transition:.15s}
  .aud:hover{border-color:var(--ink-3);transform:translateY(-2px)}
  .aud-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .aud h3{font-size:1.18rem;letter-spacing:-0.015em;color:var(--ink)}
  .aud p{color:var(--ink-2);font-size:0.98rem;margin-top:10px;line-height:1.5;flex:1}
  .aud-price{font-family:var(--font-mono);font-size:12px;color:var(--ember);flex:none}
  .aud-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ember);border:1px solid var(--ember);border-radius:20px;padding:2px 9px;flex:none}
  .aud-go{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-family:var(--font-mono);font-size:12.5px;color:var(--ember)}
</style>
</Base>
