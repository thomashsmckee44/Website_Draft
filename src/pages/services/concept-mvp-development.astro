---
import Base from "../../layouts/Base.astro";
import "../../styles/service.css";

const SITE = "https://www.tmdesignengineering.com";
const url = `${SITE}/services/concept-mvp-development`;
const faqs = [
  ["How much does it cost?", "It depends on how far you want to go and how complex the product is, so I don't quote a single number blind. We start with a small, fixed-price discovery (from £650), and I scope and price the concept and MVP phases from there — you approve each phase before it starts."],
  ["My idea is really rough — is it too early?", "No — early is ideal. The whole point of starting with discovery is to shape a rough idea into something concrete and buildable before any real money is spent."],
  ["What if it turns out not to be feasible?", "Then you'll know quickly and cheaply, at the discovery stage, with the reasons and any alternative directions — long before you've sunk money into building the wrong thing."],
  ["Do you do the industrial design / styling too?", "I'm a design engineer, so I lead on making the product work and be manufacturable, and I handle functional and early-stage industrial design. When a product needs heavy aesthetic styling I bring in a trusted ID partner, so you still get one joined-up process."],
  ["Will you sign an NDA?", "Yes, gladly — before you share anything sensitive. Protecting your idea is part of the job, and it's a topic I can genuinely advise on."],
  ["What happens after the MVP?", "If you want to take it to market, we move into full product development — detailed design, verification and manufacturing preparation — carrying everything the MVP taught us straight into a production-ready product."],
];
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${url}#service`,
    serviceType: "Concept and MVP development",
    name: "Concept & MVP Development",
    description: "Turn a product idea into an evaluated, buildable concept and a working MVP you can put in front of users, investors or a crowdfunding audience — delivered in scoped, gated phases.",
    provider: { "@id": `${SITE}/#business` },
    areaServed: ["United Kingdom", "Worldwide"],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Concept & MVP Development", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<Base
  title="Concept & MVP Development for Hardware Startups | Thomas McKee"
  description="Turn your idea into an evaluated, buildable concept and a working MVP you can put in front of users, investors or a crowd — with the structure and momentum of someone who's shipped award-winning products."
  type="website"
  jsonld={jsonld}>
<main>
  <!-- HERO -->
  <section class="svc-hero">
    <div class="wrap svc-hero-grid">
      <div>
        <span class="eyebrow">Service · Concept &amp; MVP Development</span>
        <h1>Turn your idea into something real you can <em>show, test and raise on.</em></h1>
        <p class="lede">I take an idea from a sketch or a description to an evaluated, buildable concept and a working MVP — a prototype that proves the core function and is good enough to put in front of users, investors or a crowdfunding audience. With the structure, rhythm and honesty of someone who's taken award-winning products to the shelf.</p>
        <div class="svc-hero-cta">
          <a class="btn btn-primary" href="/#contact">Book a free intro call <span class="arw">→</span></a>
          <a class="btn btn-ghost" href="#mvp">What's an MVP?</a>
        </div>
      </div>
      <aside class="spec" aria-label="Service summary">
        <div class="spec-head"><span>Service Spec</span><span>CM—02</span></div>
        <div class="spec-row"><div class="spec-k">Deliver</div><div class="spec-v">Concept + working MVP</div></div>
        <div class="spec-row"><div class="spec-k">Starts with</div><div class="spec-v">A short paid discovery</div></div>
        <div class="spec-row"><div class="spec-k">Shape</div><div class="spec-v">Scoped phases</div></div>
        <div class="spec-row"><div class="spec-k">Price</div><div class="spec-v">Scoped up front</div></div>
        <div class="spec-row"><div class="spec-k">You need</div><div class="spec-v">An idea to start</div></div>
        <div class="spec-note">Every engagement opens with a short, paid discovery (often a Feasibility Study) that de-risks the idea and prices the rest — so you commit in steps, never all at once.</div>
      </aside>
    </div>
  </section>

  <!-- WHAT AN MVP IS -->
  <section class="band alt" id="mvp">
    <div class="wrap">
      <span class="sec-idx">First, the honest bit</span>
      <h2 class="sec-title">What an "MVP" actually means for a physical product</h2>
      <p class="sec-intro">"MVP" comes from software, and in hardware it gets used to mean everything from a rough proof-of-concept to a first production run. Left vague, that's exactly how projects blow their budget. So we pin it down before we start.</p>
      <div class="proof">
        <div class="pl">Working definition</div>
        <p><strong>For a physical product, an MVP is a working prototype that proves the core function and is good enough to put in front of real people</strong> — users to learn from, investors to convince, or a crowdfunding audience to win. It is not the finished, manufacturable product; it's the smallest real thing that earns you the right (and the evidence) to build that.</p>
      </div>
      <p class="sec-intro" style="margin-top:22px">We agree exactly which level of "working" you need up front, so there are no surprises about what you're getting:</p>
      <div class="ladder">
        <span class="rung"><span class="n">01</span> <b>Proof-of-principle</b> · does the core idea work?</span>
        <span class="rung"><span class="n">02</span> <b>Looks-like</b> · form &amp; feel</span>
        <span class="rung"><span class="n">03</span> <b>Works-like</b> · real function</span>
        <span class="rung"><span class="n">04</span> <b>Investor / crowd-ready</b> · convincing on both</span>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="band">
    <div class="wrap">
      <span class="sec-idx">What you get</span>
      <h2 class="sec-title">From idea to a thing in your hands</h2>
      <div class="deliv">
        <div class="di"><div class="dn">01</div><h3>An evaluated concept</h3><p>Your idea developed into a concept that actually works — pressure-tested for feasibility, cost and manufacture, not just how it looks.</p></div>
        <div class="di"><div class="dn">02</div><h3>A clear brief &amp; spec</h3><p>The requirements written down properly, so every later decision has something objective to be measured against.</p></div>
        <div class="di"><div class="dn">03</div><h3>A working MVP</h3><p>A prototype at the fidelity we agreed — the real, demonstrable thing you can test, show and raise on.</p></div>
        <div class="di"><div class="dn">04</div><h3>A plan to production</h3><p>A clear route from the MVP to a manufacturable product, with the future baked into the early design so nothing has to be torn up later.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">How it works</span>
      <h2 class="sec-title">Structure and rhythm, not chaos</h2>
      <p class="sec-intro">Most of my clients are doing this for the first time. What helps most isn't just the engineering — it's a steady, honest process that keeps momentum without letting the excitement run ahead of the evidence.</p>
      <div class="steps">
        <div class="step"><div class="sn">1</div><div><h3>Discovery &amp; de-risk</h3><p>We start small and paid — usually a Feasibility Study — to prove the idea holds up and to scope and price everything that follows. No big commitment on day one.</p><div class="meta">Fixed scope · from £650</div></div></div>
        <div class="step"><div class="sn">2</div><div><h3>Concept development &amp; evaluation</h3><p>I develop the idea into real, buildable options and we weigh them honestly — feasibility, cost and experience — so we choose a direction for the right reasons, not the loudest opinion in the room.</p><div class="meta">Scoped phase</div></div></div>
        <div class="step"><div class="sn">3</div><div><h3>Fail-fast prototyping</h3><p>We prototype quickly and cheaply to answer the real questions, learning fast and keeping momentum — with future manufacture considered from the start, so progress never has to be undone.</p><div class="meta">Scoped phase</div></div></div>
        <div class="step"><div class="sn">4</div><div><h3>A working MVP + a plan</h3><p>You end with the demonstrable MVP we agreed and a clear route to production — ready to test, pitch, or move into full product development.</p><div class="meta">Deliverable</div></div></div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="band">
    <div class="wrap">
      <span class="sec-idx">Why me</span>
      <h2 class="sec-title">A deceptively simple idea, done properly</h2>
      <div class="proof">
        <div class="pl">From the work</div>
        <p>My first design-engineering product for Ooni looked like a simple plastic tray. Underneath sat a knot of competing constraints — fridge sizes across regions, nesting, injection-moulding limits, tolerance stack-up. Rather than iterate blindly, I <strong>modelled the trade-offs and made the calls before cutting steel</strong>. It's sold for over three years — and the geometry is the single most-praised thing in the reviews. That's the whole game: get the hard thinking right early, and the product feels effortless to everyone else.</p>
      </div>
      <div class="svc-cred">
        <span class="ci">Behind <b>Red Dot</b> &amp; <b>iF Design Award</b>–winning products</span>
        <span class="ci"><b>Mechanical, firmware &amp; manufacture</b> seen as one system</span>
        <span class="ci">Plain-English about the <b>hard trade-offs</b></span>
      </div>
    </div>
  </section>

  <!-- SCOPE -->
  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">Scope</span>
      <h2 class="sec-title">Clear on both sides</h2>
      <div class="scope">
        <div class="scard need">
          <h3>What you bring</h3>
          <ul>
            <li><span class="tick">→</span> An idea or rough concept — however early. If it's barely more than a thought, we start with discovery.</li>
            <li><span class="tick">→</span> A sense of who it's for and what "success" looks like for your MVP.</li>
            <li><span class="tick">→</span> Openness to honest feedback — including if the idea needs to change.</li>
          </ul>
        </div>
        <div class="scard">
          <h3>How I work</h3>
          <ul>
            <li><span class="tick">✓</span> Engineering-led: I take a concept and make it real. For heavy aesthetic styling I bring in a specialist industrial-design partner.</li>
            <li><span class="tick">✓</span> Scoped, gated phases — you see and approve the cost before each one.</li>
            <li><span class="tick">✓</span> Happy to work under an NDA from the very first conversation.</li>
            <li><span class="tick">✓</span> Everything explained in plain terms — no hiding behind jargon.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band">
    <div class="wrap">
      <span class="sec-idx">Questions</span>
      <h2 class="sec-title">Common questions</h2>
      <div class="faq">
        <div class="fitem"><div class="fq">How much does it cost?</div><div class="fa">It depends on how far you want to go and how complex the product is, so I don't quote a single number blind. We start with a small, fixed-price discovery (from £650), and I scope and price the concept and MVP phases from there — you approve each phase before it starts.</div></div>
        <div class="fitem"><div class="fq">My idea is really rough — is it too early?</div><div class="fa">No — early is ideal. The whole point of starting with discovery is to shape a rough idea into something concrete and buildable before any real money is spent.</div></div>
        <div class="fitem"><div class="fq">What if it turns out not to be feasible?</div><div class="fa">Then you'll know quickly and cheaply, at the discovery stage, with the reasons and any alternative directions — long before you've sunk money into building the wrong thing.</div></div>
        <div class="fitem"><div class="fq">Do you do the industrial design / styling too?</div><div class="fa">I'm a design engineer, so I lead on making the product work and be manufacturable, and I handle functional and early-stage industrial design. When a product needs heavy aesthetic styling I bring in a trusted ID partner, so you still get one joined-up process.</div></div>
        <div class="fitem"><div class="fq">Will you sign an NDA?</div><div class="fa">Yes, gladly — before you share anything sensitive. Protecting your idea is part of the job, and it's a topic I can genuinely advise on.</div></div>
        <div class="fitem"><div class="fq">What happens after the MVP?</div><div class="fa">If you want to take it to market, we move into full product development — detailed design, validation and manufacturing preparation — carrying everything the MVP taught us straight into a production-ready product.</div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band" id="start">
    <div class="wrap">
      <div class="cta">
        <div class="inner">
          <span class="eyebrow">Let's build it</span>
          <h2 style="margin-top:14px">Ready to make your idea real?</h2>
          <p>Book a free introductory call and tell me about it. We'll talk through where you are, what a sensible first step looks like, and how to get you to a working MVP without wasting a penny on the wrong thing.</p>
          <div class="row">
            <a class="btn btn-primary btn-lg" href="/#contact">Book a free intro call <span class="arw">→</span></a>
            <span class="price-tag">Starts with discovery from <b>£650</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>
