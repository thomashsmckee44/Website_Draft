---
import Base from "../../layouts/Base.astro";
import "../../styles/service.css";

const SITE = "https://www.tmdesignengineering.com";
const url = `${SITE}/services/design-review`;
const faqs = [
  ["What can you review?", "A design, a concept, a prototype, a set of CAD files or drawings, or a product that's misbehaving. I look at feasibility, manufacturability, cost drivers, likely failure modes and whether the design does what it needs to, whatever is most useful for the decision you're facing."],
  ["What do I need to send you?", "Whatever you have, CAD, drawings, photos, a spec, or just a clear description. The more you can share, the deeper the review; but even a rough concept can get a genuinely useful assessment."],
  ["Is the report actually written down?", "Yes, that's the point. You get a proper written report with prioritised, actionable recommendations, not just a verbal chat you have to remember. It's yours to use, share with your team or take to a supplier."],
  ["What if my design needs more than half a day?", "A half-day covers most single-design reviews well. If yours is bigger or you want deeper analysis, simulation or testing, that's Design Verification, I'll tell you on booking and scope it with a fixed quote."],
  ["How is this different from Design Verification?", "A Design Review is fast, senior eyes plus a written report, an expert second opinion to catch the big issues. Design Verification is the deeper programme of analysis, simulation and structured testing that proves a design before tooling. The review is often the sensible first step toward it."],
  ["Will you sign an NDA?", "Yes, happily, before you share anything sensitive."],
];
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${url}#service`,
    serviceType: "Design and engineering review",
    name: "Design Review",
    description: "A half-day expert review of your product design, concept or prototype, feasibility, manufacturability, cost and risk, delivered with a written report of prioritised recommendations. From £200.",
    provider: { "@id": `${SITE}/#business` },
    areaServed: ["United Kingdom", "Worldwide"],
    offers: { "@type": "Offer", price: "200", priceCurrency: "GBP", url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Design Review", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---
<Base
  title="Design Review, Expert Engineering Review (from £200) | Thomas McKee"
  description="A half-day expert review of your product design, concept or prototype, feasibility, manufacturability, cost and risk, with a written report of prioritised recommendations. From £200."
  type="website"
  jsonld={jsonld}>
<main>
  <section class="svc-hero">
    <div class="wrap svc-hero-grid">
      <div>
        <span class="eyebrow">Entry offer · Design Review</span>
        <h1>A senior second opinion on your design, <em>with a report you can act on.</em></h1>
        <p class="lede">A half-day expert review of your design, concept or prototype, feasibility, manufacturability, cost and the risks you might not see yet, delivered as a written report of prioritised recommendations. A low-cost way to catch expensive problems early. From £200.</p>
        <div class="svc-hero-cta">
          <a class="btn btn-primary" href="/#contact">Book a Design Review <span class="arw">→</span></a>
          <a class="btn btn-ghost" href="#included">What you get</a>
        </div>
      </div>
      <aside class="spec" aria-label="Service summary">
        <div class="spec-head"><span>Service Spec</span><span>DR-E2</span></div>
        <div class="spec-price"><span class="from">From</span><span class="amt">£200</span></div>
        <div class="spec-row"><div class="spec-k">Deliver</div><div class="spec-v">Written report</div></div>
        <div class="spec-row"><div class="spec-k">Effort</div><div class="spec-v">Half a day</div></div>
        <div class="spec-row"><div class="spec-k">Format</div><div class="spec-v">Review + walk-through</div></div>
        <div class="spec-row"><div class="spec-k">You need</div><div class="spec-v">A design or concept</div></div>
        <div class="spec-note">Fixed price for a single design. Bigger jobs, or deeper analysis and testing, move into Design Verification with a scoped quote.</div>
      </aside>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">Who it's for</span>
      <h2 class="sec-title">When you want experienced eyes before you commit</h2>
      <div class="pain">
        <div class="q"><span class="mk">?</span><p>"I'm about to spend real money on this design, is it actually sound?"</p></div>
        <div class="q"><span class="mk">?</span><p>"I've inherited a design and I don't know if I can trust it."</p></div>
        <div class="q"><span class="mk">?</span><p>"Something's nagging me, the cost, the manufacturability, a part I think will fail."</p></div>
      </div>
      <p class="sec-intro">A few hundred pounds and a couple of days is a small price to find the flaw that would have cost you a tool, a recall or a wasted development cycle.</p>
    </div>
  </section>

  <section class="band" id="included">
    <div class="wrap">
      <span class="sec-idx">What you get</span>
      <h2 class="sec-title">A review you can hold in your hand</h2>
      <div class="deliv">
        <div class="di"><div class="dn">01</div><h3>A structured review</h3><p>Your design assessed across the things that decide whether it succeeds, feasibility, manufacturability, cost drivers, risk and how well it meets its purpose.</p></div>
        <div class="di"><div class="dn">02</div><h3>A written report</h3><p>Findings set out clearly on paper, what's strong, what's risky, and why, so you can act on it, share it and refer back to it.</p></div>
        <div class="di"><div class="dn">03</div><h3>Prioritised recommendations</h3><p>Specific, ranked suggestions, what to fix first, what can wait, and what to leave alone, not a vague list of everything imaginable.</p></div>
        <div class="di"><div class="dn">04</div><h3>A walk-through call</h3><p>We go through the report together so nothing is lost in translation and you can ask the follow-up questions that matter.</p></div>
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <span class="sec-idx">How it works</span>
      <h2 class="sec-title">From files to findings in days</h2>
      <div class="steps">
        <div class="step"><div class="sn">1</div><div><h3>Book it</h3><p>Confirm the review and send me what you've got. Fixed price from £200, agreed before we start.</p><div class="meta">From £200</div></div></div>
        <div class="step"><div class="sn">2</div><div><h3>Share your design</h3><p>CAD, drawings, photos, a spec or a description, whatever represents the design you want looked at.</p><div class="meta">Your files</div></div></div>
        <div class="step"><div class="sn">3</div><div><h3>The review</h3><p>I work through it properly, half a day of experienced attention across function, manufacture, cost and risk.</p><div class="meta">≈ Half a day</div></div></div>
        <div class="step"><div class="sn">4</div><div><h3>Report &amp; walk-through</h3><p>You get the written report and we talk it through, with clear, prioritised next steps.</p><div class="meta">Included</div></div></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="sec-idx">Questions</span>
      <h2 class="sec-title">Before you book</h2>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <div class="fitem"><div class="fq">{q}</div><div class="fa">{a}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt" id="start">
    <div class="wrap">
      <div class="cta">
        <div class="inner">
          <span class="eyebrow">Start here</span>
          <h2 style="margin-top:14px">Catch the expensive problems early</h2>
          <p>Book a Design Review and get an experienced engineer's honest assessment, in writing, before you commit time, money or tooling to the current design.</p>
          <div class="row">
            <a class="btn btn-primary btn-lg" href="/#contact">Book a Design Review <span class="arw">→</span></a>
            <span class="price-tag">From <b>£200</b>, report included</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>
