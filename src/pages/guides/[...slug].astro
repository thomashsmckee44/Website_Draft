---
import Base from "../../layouts/Base.astro";
import "../../styles/service.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const SITE = "https://www.tmdesignengineering.com";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((entry) => ({ params: { slug: entry.slug }, props: { entry, all: guides } }));
}

type Props = { entry: CollectionEntry<"guides">; all: CollectionEntry<"guides">[] };
const { entry, all } = Astro.props;
const { Content } = await entry.render();
const url = `${SITE}/guides/${entry.slug}`;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });

const isPillar = entry.data.kind === "pillar";
const parent = !isPillar && entry.data.pillar ? all.find((g) => g.slug === entry.data.pillar) : undefined;
const children = isPillar
  ? all
      .filter((g) => g.data.kind === "cluster" && g.data.pillar === entry.slug)
      .sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf())
  : [];

const crumbs = [
  { name: "Home", item: `${SITE}/` },
  { name: "Guides", item: `${SITE}/guides` },
];
if (parent) crumbs.push({ name: parent.data.title, item: `${SITE}/guides/${parent.slug}` });
crumbs.push({ name: entry.data.title, item: url });

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${url}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
    author: { "@id": `${SITE}/#thomas-mckee` },
    publisher: { "@id": `${SITE}/#business` },
    isPartOf: { "@id": `${SITE}/#website` },
    mainEntityOfPage: url,
    url,
    keywords: entry.data.tags.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: c.item,
    })),
  },
];
---
<Base
  title={`${entry.data.title} | Thomas McKee`}
  description={entry.data.description}
  type="article"
  jsonld={jsonld}>
<main>
  <article class="svc-hero" style="padding-bottom:0">
    <div class="wrap" style="max-width:760px">
      <a class="back" href={parent ? `/guides/${parent.slug}` : "/guides"}>← {parent ? parent.data.title : "Guides"}</a>
      <div class="art-meta">
        <span class="hub-cat">{entry.data.category}</span>
        <span>{fmt(entry.data.date)}</span>
        {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lede" style="max-width:none">{entry.data.description}</p>
    </div>
  </article>
  <section class="band" style="border-top:0;padding-top:28px">
    <div class="wrap" style="max-width:760px">
      <div class="prose"><Content /></div>

      {isPillar && children.length > 0 && (
        <div class="in-guide">
          <div class="ig-h">In this guide</div>
          <div class="ig-list">
            {children.map((c) => (
              <a class="ig-row" href={`/guides/${c.slug}`}>
                <span>{c.data.title}</span><span class="arw">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {entry.data.cta && (
        <div class="art-cta">
          <a class="btn btn-primary btn-lg" href={entry.data.cta.href}>{entry.data.cta.label} <span class="arw">→</span></a>
        </div>
      )}

      {parent && (
        <p class="art-back">Part of <a href={`/guides/${parent.slug}`}>{parent.data.title}</a> · <a href="/guides">all guides</a></p>
      )}
      {isPillar && (
        <p class="art-back"><a href="/guides">← All guides</a></p>
      )}
    </div>
  </section>
</main>
<style>
  .back{font-family:var(--font-mono);font-size:12px;color:var(--ink-3);text-decoration:none}
  .back:hover{color:var(--ember)}
  .art-meta{display:flex;gap:16px;font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-top:22px}
  .hub-cat{color:var(--ember)}
  .prose{color:var(--ink-2);font-size:1.05rem;line-height:1.7}
  .prose :global(h2){font-family:var(--font-display);color:var(--ink);font-size:1.5rem;font-weight:700;letter-spacing:-0.02em;margin:38px 0 14px}
  .prose :global(h3){font-family:var(--font-display);color:var(--ink);font-size:1.2rem;font-weight:600;margin:28px 0 10px}
  .prose :global(p){margin:0 0 18px}
  .prose :global(ul),.prose :global(ol){margin:0 0 18px;padding-left:22px;display:flex;flex-direction:column;gap:9px}
  .prose :global(li){padding-left:4px}
  .prose :global(a){color:var(--ember)}
  .prose :global(strong){color:var(--ink);font-weight:600}
  .in-guide{margin-top:38px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);overflow:hidden}
  .ig-h{font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);padding:16px 22px 0}
  .ig-list{margin-top:8px}
  .ig-row{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:15px 22px;border-top:1px solid var(--line);text-decoration:none;color:var(--ink);font-weight:500}
  .ig-row:hover{background:var(--surface);color:var(--ember)}
  .art-cta{margin:38px 0 0;padding-top:28px;border-top:1px solid var(--line)}
  .art-back{margin-top:26px;font-family:var(--font-mono);font-size:12px;color:var(--ink-3)}
  .art-back a{color:var(--ember);text-decoration:none}
</style>
</Base>
